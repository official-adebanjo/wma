{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@mobile/*": ["mobile/*"],
      "@admin/*": ["admin/*"]
    },
    "types": ["node", "mocha", "@wdio/globals/types", "@wdio/mocha-framework"]
  },
  "include": ["shared/**/*.ts", "unit/**/*.ts", "api-tests/**/*.ts", "admin/**/*.ts", "mobile/**/*.ts", "playwright.config.ts"]
}
