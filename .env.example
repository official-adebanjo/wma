# Copy to .env and fill in. NEVER commit .env — credentials live in the team vault / CI secrets.

# ---- Environment ----
TEST_ENV=dev                         # dev | staging  (production is never a target)
API_BASE_URL=https://treasury-api-dev.rosabon-finance.com
ADMIN_BASE_URL=https://rosabon-app-admin-dev.rosabon-finance.com
# QA-only seeding / clock-control hooks (see docs/TEST-HOOKS.md). Must be disabled in production builds.
QA_HOOKS_BASE_URL=
QA_HOOKS_TOKEN=

# ---- Customer test accounts (mobile + API). One per KYC tier. ----
# Sign-in is email + password OR phone + passcode/PIN; tests for a method skip when its pair is blank.
CUSTOMER_T1_EMAIL=
CUSTOMER_T1_PASSWORD=
CUSTOMER_T1_PHONE=
CUSTOMER_T1_PIN=
CUSTOMER_T2_EMAIL=
CUSTOMER_T2_PASSWORD=
CUSTOMER_T2_PHONE=
CUSTOMER_T2_PIN=
CUSTOMER_T3_EMAIL=
CUSTOMER_T3_PASSWORD=
CUSTOMER_T3_PHONE=
CUSTOMER_T3_PIN=
CUSTOMER_CORPORATE_EMAIL=
CUSTOMER_CORPORATE_PASSWORD=
CUSTOMER_CORPORATE_PHONE=
CUSTOMER_CORPORATE_PIN=
TEST_OTP=                            # static OTP accepted by the dev OTP gateway stub

# ---- Admin personas (Playwright). Format: ADMIN_<PERSONA>_EMAIL / _PASSWORD ----
ADMIN_SUPER_ADMIN_EMAIL=
ADMIN_SUPER_ADMIN_PASSWORD=
ADMIN_COMPLIANCE_EMAIL=
ADMIN_COMPLIANCE_PASSWORD=
ADMIN_KYC_REVIEWER_EMAIL=
ADMIN_KYC_REVIEWER_PASSWORD=
ADMIN_TREASURY_OFFICER_EMAIL=
ADMIN_TREASURY_OFFICER_PASSWORD=
ADMIN_HEAD_OF_CRM_EMAIL=
ADMIN_HEAD_OF_CRM_PASSWORD=
ADMIN_HEAD_OF_OPS_EMAIL=
ADMIN_HEAD_OF_OPS_PASSWORD=
ADMIN_HEAD_OF_CREDIT_EMAIL=
ADMIN_HEAD_OF_CREDIT_PASSWORD=
ADMIN_LOAN_ACCOUNT_OFFICER_EMAIL=
ADMIN_LOAN_ACCOUNT_OFFICER_PASSWORD=
ADMIN_COLLECTIONS_OFFICER_EMAIL=
ADMIN_COLLECTIONS_OFFICER_PASSWORD=
ADMIN_PAYROLL_OPS_LEAD_EMAIL=
ADMIN_PAYROLL_OPS_LEAD_PASSWORD=
ADMIN_HEAD_OF_PUBLIC_SECTOR_EMAIL=
ADMIN_HEAD_OF_PUBLIC_SECTOR_PASSWORD=
ADMIN_MARKETING_EMAIL=
ADMIN_MARKETING_PASSWORD=
ADMIN_HEAD_OF_MARKETING_EMAIL=
ADMIN_HEAD_OF_MARKETING_PASSWORD=
ADMIN_PRODUCT_MANAGER_EMAIL=
ADMIN_PRODUCT_MANAGER_PASSWORD=
ADMIN_CPO_EMAIL=
ADMIN_CPO_PASSWORD=
ADMIN_HEAD_OF_TREASURY_EMAIL=
ADMIN_HEAD_OF_TREASURY_PASSWORD=
ADMIN_SUPPORT_AGENT_EMAIL=
ADMIN_SUPPORT_AGENT_PASSWORD=
ADMIN_READ_ONLY_EMAIL=
ADMIN_READ_ONLY_PASSWORD=

# ---- Mobile: local Appium ----
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
ANDROID_APP_PATH=./apps/rosabon-dev.apk
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_AVD=                         # emulator name (avdmanager list avd); Appium boots it if none is running
ANDROID_PLATFORM_VERSION=            # optional
IOS_APP_PATH=./apps/rosabon-dev.app
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.5
APP_PACKAGE=com.optisoft.rosabon
APP_BUNDLE_ID=com.optisoft.rosabon

# ---- Mobile: TestMu AI / LambdaTest real-device cloud ----
LT_USERNAME=
LT_ACCESS_KEY=
LT_APP_ID_ANDROID=                   # lt://APP... from the LambdaTest app upload API
LT_APP_ID_IOS=
LT_PARALLEL_SESSIONS=1               # capped at 1 per QA Strategy §35.3

# ---- Product configuration defaults (mirror Admin → Product Management; override per env) ----
WHT_RATE_PCT=10
RWIN_MIN_DEPOSIT=50000
RWIN_PLAN_CAP=100000000
RWIN_MIN_RETAINED=50000
REAP_MIN_TARGET=10000
RTN_MIN_INDIVIDUAL=1000000
RTN_MIN_CORPORATE=10000000
RTN_UNDERFUNDED_HOLD_HOURS=24
PAYDAY_SALARY_CAP_PCT=50

# ---- Additional admin roles referenced by the Admin PRD (loan approval bands / platform governance) ----
# Format ADMIN_<ROLE>_EMAIL / ADMIN_<ROLE>_PASSWORD. Tests needing a missing role skip with a reason.
# Loan bands & collections (admin/fixtures/loan-personas.ts):
#   TEAM_LEAD, CRM, GM, EXECUTIVE, CREDIT_MANAGER, MD, UNDERWRITER, HEAD_OF_COLLECTIONS
# Platform governance (admin/fixtures/platform-personas.ts):
#   CTO, CMO, HEAD_OF_SUPPORT, MARKETING_OPS, RATE_COMMITTEE, CREDIT_COMMITTEE, BOARD, AUDITOR,
#   COMPLIANCE_OFFICER, COMPLIANCE_PREPARER, FINANCE
# Throwaway admin that the "suspend admin" test suspends — reset after each run:
ADMIN_SUSPEND_TARGET_EMAIL=
ADMIN_SUSPEND_TARGET_PASSWORD=
# Disposable active products the "retire product" tests may retire (tests skip if unset):
QA_RETIRABLE_INVESTMENT_PRODUCT=
QA_RETIRABLE_LOAN_PRODUCT=

# ---- Mobile extras ----
APP_SCHEME=                          # deep-link scheme — dev build v1.1.55 declares none yet
MOBILE_ID_STRATEGY=accessibility-id  # or resource-id (Android testID → resource-id mapping)
SESSION_TIMEOUT_SECONDS=300

# ---- Real dev Admin Portal (project "admin-dev") ----
DEV_ADMIN_URL=https://rosabon-app-admin-dev.rosabon-finance.com
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_ALLOW_DESTRUCTIVE=0

# ---- Netlify (local `npm run deploy:report` only) ----
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
